# Copy to profiles/india.conf and fill in real keys/addresses.
# Never commit a real PrivateKey to GitHub.
[Interface]
PrivateKey = YOUR_CLIENT_PRIVATE_KEY
Address = 10.8.0.2/32
DNS = 1.1.1.1, 1.0.0.1

[Peer]
PublicKey = YOUR_SERVER_PUBLIC_KEY
# Full IPv4 tunnel. Add , ::/0 only after the server has working IPv6 forwarding/NAT.
AllowedIPs = 0.0.0.0/0
Endpoint = YOUR_SERVER_IP:51820
PersistentKeepalive = 25
